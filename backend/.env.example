# ═══════════════════════════════════════════════════════════════════════════
# MediFlow AI - Environment Variables Template
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Get your connection string from MongoDB Atlas or local instance
MONGODB_URI=mongodb://localhost:27017/mediflow
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mediflow?retryWrites=true&w=majority

# Clerk Authentication
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY WARNING
# ═══════════════════════════════════════════════════════════════════════════
# Never commit the actual .env file with real credentials to version control
# This .env.example file should only contain placeholder values
# ═══════════════════════════════════════════════════════════════════════════
